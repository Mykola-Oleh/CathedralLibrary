<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Кафедральна бібліотека</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Кафедральна бібліотека</a>
            </div>
        </nav>
    </header>
    <main role="main">@RenderBody()</main>
    <footer class="border-top footer text-muted py-3"><div class="container">Навчальний проєкт · ASP.NET Core MVC · PostgreSQL</div></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
