@model IEnumerable<CathedralLibrary.Models.LibraryRequest>
@{
    ViewData["Title"] = "Запити";
}
<div class="container py-4">
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Запити</h1>
    <a asp-action="Create" class="btn btn-primary">+ Додати</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Читач</th><th>Видання</th><th>Статус</th><th>Дата запиту</th><th>Дії</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Reader.FullName</td><td>@item.Copy.Publication.Title</td><td>@item.RequestStatus.Name</td>
                    <td>@item.RequestedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id">Перегляд</a> ·
                        <a asp-action="Edit" asp-route-id="@item.Id">Змінити</a> ·
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">Записів не знайдено.</div>
}
</div>
