@model CathedralLibrary.Models.LibraryRequest
@{
    ViewData["Title"] = "Запит — деталі";
}
<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small">← До списку</a>
        <h1 class="mt-2">Запит: @Model.Reader.FullName</h1>
        <p class="text-secondary">Детальна інформація про запис у бібліотеці.</p>
    </div>
    <div class="card detail-panel">
        <div class="card-body p-4 p-lg-5">
            <h2 class="h5 mb-4">Основні відомості</h2>
            <dl class="row g-3">
                <dt class="col-sm-4">Читач</dt>
                <dd class="col-sm-8">@Model.Reader.FullName</dd>
                <dt class="col-sm-4">Видання</dt>
                <dd class="col-sm-8">@Model.Copy.Publication.Title</dd>
                <dt class="col-sm-4">Статус</dt>
                <dd class="col-sm-8">@Model.RequestStatus.Name</dd>
            </dl>
            <div class="d-flex gap-2 flex-wrap mt-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редагувати</a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary">Назад до списку</a>
            </div>
        </div>
    </div>
</div>
