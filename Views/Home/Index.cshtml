@foreach (var item in new[]
{
    ("Автори", "Authors"),
    ("Читачі", "Readers"),
    ("Примірники", "Copies"),
    ("Запити", "Requests")
})
{
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">@item.Item1</h2>
                <a asp-controller="@item.Item2"
                   asp-action="Index"
                   class="stretched-link">
                    Відкрити розділ
                </a>
            </div>
        </div>
    </div>
}